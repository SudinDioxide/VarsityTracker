@model VarsityTracker.Core.Models.Match
@{
    ViewData["Title"] = "Cancel Match Fixture";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-calendar-x me-2"></i>Cancel Match Fixture</h5>
            </div>
            <div class="card-body p-4 text-center">
                <p class="fs-5 text-dark">Are you sure you want to cancel and remove this fixture?</p>
                <div class="alert alert-warning text-start">
                    <div><strong>Fixture:</strong> @Model.HomeFaculty?.FacultyCode vs @Model.AwayFaculty?.FacultyCode</div>
                    <div><strong>Sport:</strong> @Model.Sport?.SportName</div>
                    <div><strong>Venue:</strong> @Model.Venue?.VenueName</div>
                    <div><strong>Scheduled Kickoff:</strong> @Model.MatchDate.ToString("dd MMM yyyy, h:mm tt")</div>
                    <div><strong>Current Status:</strong> @Model.Status</div>
                </div>

                <form asp-action="Delete" method="post" class="mt-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MatchId" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Keep Fixture
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash-fill me-1"></i> Cancel & Remove
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

