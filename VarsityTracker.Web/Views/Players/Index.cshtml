@model IEnumerable<VarsityTracker.Core.Models.Player>
@{
    ViewData["Title"] = "Player Rosters";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Athlete Rosters</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">Athlete Rosters</h2>
            <span class="badge bg-primary rounded-pill">@Model.Count() Athletes</span>
        </div>
        <p class="text-muted mb-0 small mt-1">Student athlete registrations, faculty affiliations, and tactical team assignments</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-person-plus me-1"></i> Register New Athlete
        </a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-mortarboard"></i></span>
                    <select name="facultyId" class="form-select" asp-items="ViewBag.Faculties">
                        <option value="">All Faculties</option>
                    </select>
                </div>
            </div>
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Search athlete by name, matric no, position..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="table-container">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Athlete Name</th>
                    <th>Matric No</th>
                    <th>Faculty Affiliation</th>
                    <th>Position / Role</th>
                    <th class="text-end" style="width: 140px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <div class="fw-semibold">No athletes match the specified criteria.</div>
                            <small>Try selecting a different faculty or registering a new athlete.</small>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-3">
                                @if (!string.IsNullOrEmpty(item.PhotoUrl))
                                {
                                    <img src="@item.PhotoUrl" alt="@item.FullName" class="rounded-circle object-fit-cover shadow-sm border" style="width: 40px; height: 40px;" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold\' style=\'width: 40px; height: 40px;\'>@item.FullName.Substring(0, 1)</div>';" />
                                }
                                else
                                {
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 40px; height: 40px; font-size: 15px;">
                                        @(string.IsNullOrWhiteSpace(item.FullName) ? "A" : item.FullName.Substring(0, 1).ToUpper())
                                    </div>
                                }
                                <div>
                                    <div class="fw-bold text-dark">@item.FullName</div>
                                    <small class="text-muted">Player ID #@item.PlayerId</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border font-monospace px-2 py-1">@item.MatricNo</span>
                        </td>
                        <td>
                            <span class="badge bg-primary px-2 py-1">@item.Faculty?.FacultyCode</span>
                            <span class="small text-muted ms-1 d-none d-lg-inline">@item.Faculty?.FacultyName</span>
                        </td>
                        <td>
                            <span class="badge badge-subtle-primary">
                                <i class="bi bi-shield me-1"></i>@item.PositionRole
                            </span>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@item.PlayerId" class="btn btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="Edit" asp-route-id="@item.PlayerId" class="btn btn-outline-primary" title="Edit Athlete">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Delete" asp-route-id="@item.PlayerId" class="btn btn-outline-danger" title="Remove Athlete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

