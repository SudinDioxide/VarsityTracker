@model VarsityTracker.Core.Models.User
@{
    ViewData["Title"] = "Student Registration";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0 rounded-3">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus me-2"></i>Student Registration</h4>
                <small class="text-white-50">Create your student profile to follow varsity matches & report venue feedback</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="MatricNo" class="form-label fw-semibold"></label>
                        <input asp-for="MatricNo" class="form-control" placeholder="e.g. AI220099" required />
                        <span asp-validation-for="MatricNo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" placeholder="Your Full Name" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" placeholder="name@siswa.uthm.edu.my" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FacultyId" class="form-label fw-semibold">Faculty Affiliation</label>
                        <select asp-for="FacultyId" class="form-select" asp-items="ViewBag.Faculties">
                            <option value="">-- Select Your Faculty --</option>
                        </select>
                        <span asp-validation-for="FacultyId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PasswordHash" class="form-label fw-semibold">Password</label>
                        <input asp-for="PasswordHash" class="form-control" type="password" placeholder="Create password" required />
                        <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a asp-action="Login" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Login
                        </a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-check-circle me-1"></i> Register Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

