@model VarsityTracker.Core.Models.VenueFeedback
@{
    ViewData["Title"] = "Report Facility Hazard";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-shield-exclamation me-2"></i>Report Facility Hazard or Equipment Issue</h5>
                <small class="text-white-50">Notify UTHM Sports Division about venue defects, lighting failures, or damaged playing surfaces</small>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="mb-3">
                        <label asp-for="VenueId" class="form-label fw-semibold">Sports Facility / Venue</label>
                        <select asp-for="VenueId" class="form-select" asp-items="ViewBag.Venues" required>
                            <option value="">-- Select Affected Facility --</option>
                        </select>
                        <span asp-validation-for="VenueId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Subject" class="form-label fw-semibold">Defect / Hazard Subject</label>
                        <input asp-for="Subject" class="form-control" placeholder="e.g. Court 2 Floodlight Blinking, Torn Goalpost Net" required />
                        <span asp-validation-for="Subject" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Details" class="form-label fw-semibold">Detailed Description</label>
                        <textarea asp-for="Details" class="form-control" rows="4" placeholder="Describe the hazard location, risk severity, and when you observed the defect..." required></textarea>
                        <span asp-validation-for="Details" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-send me-1"></i> Submit Ticket
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

