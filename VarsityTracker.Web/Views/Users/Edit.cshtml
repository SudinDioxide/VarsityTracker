@model VarsityTracker.Core.Models.User
@{
    ViewData["Title"] = "Edit User";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-warning text-dark py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Update User Account & Role</h5>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="MatricNo" class="form-label fw-semibold"></label>
                            <input asp-for="MatricNo" class="form-control" required />
                            <span asp-validation-for="MatricNo" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label fw-semibold">Role Authority</label>
                            <select asp-for="Role" class="form-select" required>
                                <option value="Admin">Admin</option>
                                <option value="Scorekeeper">Scorekeeper</option>
                                <option value="Student">Student</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" type="email" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FacultyId" class="form-label fw-semibold">Faculty Affiliation</label>
                        <select asp-for="FacultyId" class="form-select" asp-items="ViewBag.Faculties">
                            <option value="">-- None / General Campus Official --</option>
                        </select>
                        <span asp-validation-for="FacultyId" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PasswordHash" class="form-label fw-semibold">Password</label>
                        <input asp-for="PasswordHash" class="form-control" type="text" required />
                        <span asp-validation-for="PasswordHash" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Users
                        </a>
                        <button type="submit" class="btn btn-warning px-4">
                            <i class="bi bi-check-lg me-1"></i> Update Account
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

