@model IEnumerable<VarsityTracker.Core.Models.Match>
@{
    ViewData["Title"] = "Live Score Command Center";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Live Score Command Center</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">Live Score Command Center</h2>
            <span class="badge bg-danger rounded-pill"><i class="bi bi-broadcast me-1"></i>Real-Time</span>
        </div>
        <p class="text-muted mb-0 small mt-1">Official scorekeeping console & AJAX score updates for tournament referees and scorekeepers</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-controller="Matches" asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-calendar-plus me-1"></i> Schedule Fixture
        </a>
    }
</div>

@if (Model.Any(m => m.Status == "Live"))
{
    <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm border-0" style="border-radius: 12px; background-color: #fee2e2; color: #991b1b;">
        <span class="spinner-grow spinner-grow-sm text-danger me-3" role="status"></span>
        <div>
            <strong>Active Live Varsity Games Ongoing:</strong> @Model.Count(m => m.Status == "Live") match(es) currently receiving real-time score updates.
        </div>
    </div>
}

<div class="row row-cols-1 row-cols-md-2 g-4">
    @foreach (var item in Model)
    {
        <div class="col">
            <div class="card h-100 card-hover shadow-sm">
                <div class="card-header bg-white pt-3 d-flex justify-content-between align-items-center">
                    <span class="badge bg-light text-dark border px-2 py-1 fw-semibold">
                        <i class="bi bi-trophy text-warning me-1"></i>@item.Sport?.SportName (@item.Sport?.ScoringType)
                    </span>
                    @if (item.Status == "Live")
                    {
                        <span class="badge badge-subtle-danger d-inline-flex align-items-center gap-1">
                            <span class="spinner-grow spinner-grow-sm text-danger" style="width: 8px; height: 8px;" role="status"></span>
                            LIVE NOW
                        </span>
                    }
                    else if (item.Status == "Completed")
                    {
                        <span class="badge badge-subtle-success d-inline-flex align-items-center gap-1">
                            <i class="bi bi-check2-circle"></i> Completed (FT)
                        </span>
                    }
                    else
                    {
                        <span class="badge badge-subtle-primary d-inline-flex align-items-center gap-1">
                            <i class="bi bi-clock"></i> Scheduled
                        </span>
                    }
                </div>

                <div class="card-body">
                    <!-- Teams & Big Score Display -->
                    <div class="row align-items-center text-center py-4 rounded-3" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); border: 1px solid #cbd5e1;">
                        <div class="col-5">
                            <span class="badge bg-primary px-3 py-1 fs-6 mb-1">@item.HomeFaculty?.FacultyCode</span>
                            <small class="text-muted text-truncate d-block fw-semibold" style="font-size: 11px;">@item.HomeFaculty?.FacultyName</small>
                            <div class="display-4 fw-bold text-dark mt-2 font-monospace">@item.HomeTotalScore</div>
                        </div>
                        <div class="col-2">
                            <span class="badge bg-white text-muted border shadow-sm px-2 py-1 fw-bold">VS</span>
                        </div>
                        <div class="col-5">
                            <span class="badge bg-danger px-3 py-1 fs-6 mb-1">@item.AwayFaculty?.FacultyCode</span>
                            <small class="text-muted text-truncate d-block fw-semibold" style="font-size: 11px;">@item.AwayFaculty?.FacultyName</small>
                            <div class="display-4 fw-bold text-dark mt-2 font-monospace">@item.AwayTotalScore</div>
                        </div>
                    </div>

                    <div class="mt-3 small text-muted">
                        <div class="mb-1"><i class="bi bi-geo-alt-fill me-1 text-danger"></i><strong>Venue:</strong> @item.Venue?.VenueName</div>
                        <div class="mb-1"><i class="bi bi-person-badge me-1 text-primary"></i><strong>Official:</strong> @(item.Scorekeeper?.FullName ?? "Unassigned")</div>
                        <div><i class="bi bi-clock me-1 text-secondary"></i><strong>Time:</strong> @item.MatchDate.ToString("dd MMM yyyy, h:mm tt")</div>
                    </div>
                </div>

                <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center flex-wrap gap-2 pb-3">
                    <div class="d-flex gap-1">
                        <a asp-controller="Matches" asp-action="Details" asp-route-id="@item.MatchId" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-eye me-1"></i> Details
                        </a>
                        <a asp-controller="Matches" asp-action="ScoreSheet" asp-route-id="@item.MatchId" class="btn btn-sm btn-outline-dark" title="Print Official UTHM Score Sheet">
                            <i class="bi bi-printer"></i> Sheet
                        </a>
                    </div>

                    @if (User.IsInRole("Admin") || User.IsInRole("Scorekeeper"))
                    {
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-warning text-dark fw-bold" onclick="quickDemoPulse(@item.MatchId, this)" title="1-Click Score Pulse for Live Viva Demo">
                                <i class="bi bi-lightning-charge-fill"></i> Pulse
                            </button>
                            <a asp-action="Console" asp-route-id="@item.MatchId" class="btn btn-sm btn-danger px-3 shadow-sm">
                                <i class="bi bi-stopwatch me-1"></i> Console
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
<script>
    function quickDemoPulse(matchId, btn) {
        btn.disabled = true;
        const originalHtml = btn.innerHTML;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        fetch('/LiveScore/SimulateDemoPulse', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ matchId: matchId })
        })
        .then(r => r.json())
        .then(d => {
            btn.innerHTML = '✔ Scored!';
            setTimeout(() => {
                location.reload();
            }, 600);
        })
        .catch(() => {
            btn.innerHTML = originalHtml;
            btn.disabled = false;
        });
    }
</script>
}

