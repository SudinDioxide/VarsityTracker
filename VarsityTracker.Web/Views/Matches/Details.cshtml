@model VarsityTracker.Core.Models.Match
@{
    ViewData["Title"] = $"{Model.HomeFaculty?.FacultyCode} vs {Model.AwayFaculty?.FacultyCode} - Match Details";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Match Fixtures</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.HomeFaculty?.FacultyCode vs @Model.AwayFaculty?.FacultyCode</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header form-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="form-card-header-icon">
                <i class="bi bi-trophy-fill"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold">@Model.Sport?.SportName</span>
                    <span class="fs-5 fw-bold text-white">@Model.HomeFaculty?.FacultyCode vs @Model.AwayFaculty?.FacultyCode</span>
                </div>
                <small class="text-white-50">Match ID #@Model.MatchId &bull; Tournament Fixture</small>
            </div>
        </div>
        <div>
            @if (Model.Status == "Live")
            {
                <span class="badge badge-subtle-danger d-inline-flex align-items-center gap-1 fs-6 px-3 py-2">
                    <span class="spinner-grow spinner-grow-sm text-danger" style="width: 8px; height: 8px;" role="status"></span>
                    LIVE NOW
                </span>
            }
            else if (Model.Status == "Completed")
            {
                <span class="badge badge-subtle-success fs-6 px-3 py-2">
                    <i class="bi bi-check2-circle me-1"></i> Completed (FT)
                </span>
            }
            else
            {
                <span class="badge badge-subtle-primary fs-6 px-3 py-2">
                    <i class="bi bi-clock me-1"></i> Scheduled
                </span>
            }
        </div>
    </div>
    <div class="card-body p-4">
        <!-- Scoreboard Header -->
        <div class="row align-items-center justify-content-center text-center py-4 rounded-3 mb-4" style="background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%); border: 1px solid #cbd5e1;">
            <div class="col-md-4">
                <span class="badge bg-primary px-3 py-1 fs-6 mb-1">@Model.HomeFaculty?.FacultyCode</span>
                <div class="text-muted small fw-semibold">@Model.HomeFaculty?.FacultyName</div>
                <div class="display-3 fw-bold text-dark mt-2 font-monospace" id="homeTotalDisplay">@Model.HomeTotalScore</div>
            </div>
            <div class="col-md-2 my-3 my-md-0">
                <span class="badge bg-white text-muted border shadow-sm px-3 py-2 fs-5 fw-bold">VS</span>
                <div class="small text-muted mt-2 fw-semibold">
                    <i class="bi bi-clock me-1 text-danger"></i>@Model.MatchDate.ToString("h:mm tt")
                </div>
            </div>
            <div class="col-md-4">
                <span class="badge bg-danger px-3 py-1 fs-6 mb-1">@Model.AwayFaculty?.FacultyCode</span>
                <div class="text-muted small fw-semibold">@Model.AwayFaculty?.FacultyName</div>
                <div class="display-3 fw-bold text-dark mt-2 font-monospace" id="awayTotalDisplay">@Model.AwayTotalScore</div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border h-100">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Campus Facility</small>
                    <div class="d-flex align-items-center gap-2 mt-1">
                        @if (!string.IsNullOrEmpty(Model.Venue?.ImageUrl))
                        {
                            <img src="@Model.Venue.ImageUrl" alt="@Model.Venue.VenueName" class="rounded object-fit-cover shadow-sm border" style="width: 44px; height: 44px;" />
                        }
                        <div>
                            <div class="fs-6 fw-bold text-dark">
                                <i class="bi bi-geo-alt-fill text-danger me-1"></i>@Model.Venue?.VenueName
                            </div>
                            <div class="small text-muted">@Model.Venue?.Location</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Scheduled Date</small>
                    <div class="fs-6 fw-bold text-dark mt-1">
                        <i class="bi bi-calendar3 text-primary me-1"></i>@Model.MatchDate.ToString("dddd, dd MMMM yyyy")
                    </div>
                    <div class="small text-muted">Kickoff: @Model.MatchDate.ToString("h:mm tt")</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Match Official / Scorekeeper</small>
                    <div class="fs-6 fw-bold text-dark mt-1">
                        <i class="bi bi-person-badge text-info me-1"></i>@(Model.Scorekeeper?.FullName ?? "Unassigned")
                    </div>
                    <div class="small text-muted">Role: Tournament Scorekeeper</div>
                </div>
            </div>
        </div>

        <!-- Period Breakdown Scores Table -->
        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-layers me-2 text-primary"></i>Period / Set Breakdown Scores</h5>
        <div class="table-container mb-4">
            <div class="table-responsive">
                <table class="table text-center align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Faculty Team</th>
                            @foreach (var p in Model.MatchScores.OrderBy(p => p.PeriodNumber))
                            {
                                <th>@(Model.Sport?.ScoringType == "Sets" ? $"Set {p.PeriodNumber}" : Model.Sport?.ScoringType == "Goals" ? $"Half {p.PeriodNumber}" : $"Q{p.PeriodNumber}")</th>
                            }
                            <th class="table-primary fw-bold">Total Score</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-start fw-bold text-primary">@Model.HomeFaculty?.FacultyCode</td>
                            @foreach (var p in Model.MatchScores.OrderBy(p => p.PeriodNumber))
                            {
                                <td class="fw-bold font-monospace">@p.HomePoints</td>
                            }
                            <td class="table-primary fw-bold fs-5 font-monospace">@Model.HomeTotalScore</td>
                        </tr>
                        <tr>
                            <td class="text-start fw-bold text-danger">@Model.AwayFaculty?.FacultyCode</td>
                            @foreach (var p in Model.MatchScores.OrderBy(p => p.PeriodNumber))
                            {
                                <td class="fw-bold font-monospace">@p.AwayPoints</td>
                            }
                            <td class="table-primary fw-bold fs-5 font-monospace">@Model.AwayTotalScore</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Live Commentary & Event Timeline -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="fw-bold mb-0 text-dark">
                    <i class="bi bi-clock-history me-2 text-danger"></i>Match Commentary &amp; Official Events (@(Model.Events?.Count ?? 0))
                </h6>
                @if (Model.Status == "Live")
                {
                    <span class="badge bg-danger pulse-dot">Live Feed Active</span>
                }
            </div>
            <div class="card-body p-3">
                @if (Model.Events != null && Model.Events.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var ev in Model.Events.OrderByDescending(e => e.CreatedAt))
                        {
                            <div class="list-group-item px-2 py-3 border-bottom d-flex align-items-center gap-3">
                                <span class="badge bg-dark font-monospace px-2 py-1 fs-6">@ev.Minute</span>
                                <div>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="fw-bold text-dark">
                                            @(ev.EventType == "Goal" ? "⚽ Goal" : ev.EventType == "Point" ? "🏀 Point" : ev.EventType == "YellowCard" ? "🟨 Caution" : ev.EventType == "RedCard" ? "🟥 Send-off" : "⏱️ Official Note")
                                        </span>
                                        @if (ev.Faculty != null)
                                        {
                                            <span class="badge bg-primary">@ev.Faculty.FacultyCode</span>
                                        }
                                    </div>
                                    <div class="small text-muted mt-1">@ev.Description</div>
                                    @if (!string.IsNullOrEmpty(ev.PlayerName))
                                    {
                                        <div class="small text-secondary fst-italic">Athlete / Official: @ev.PlayerName</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3 small">
                        No official match commentary events logged yet. Match officials will post updates during play.
                    </div>
                }
            </div>
        </div>

        <div class="pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Schedule
            </a>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="ScoreSheet" asp-route-id="@Model.MatchId" class="btn btn-outline-dark">
                    <i class="bi bi-printer me-1"></i> Official Score Sheet
                </a>
                @if (User.IsInRole("Admin") || User.IsInRole("Scorekeeper"))
                {
                    <a asp-controller="LiveScore" asp-action="Console" asp-route-id="@Model.MatchId" class="btn btn-danger shadow-sm">
                        <i class="bi bi-stopwatch me-1"></i> Open Live Console
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.MatchId" class="btn btn-warning fw-bold shadow-sm">
                        <i class="bi bi-pencil me-1"></i> Edit Fixture
                    </a>
                }
            </div>
        </div>
    </div>
</div>

