@model VarsityTracker.Core.Models.User
@{
    ViewData["Title"] = "User Details - " + Model.FullName;
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-dark text-white py-3 d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-person-circle fs-5 me-2 text-warning"></i>
            <span class="fs-5 fw-bold">@Model.FullName</span>
        </div>
        <span class="badge @(Model.Role == "Admin" ? "bg-danger" : Model.Role == "Scorekeeper" ? "bg-warning text-dark" : "bg-info text-dark") fs-6">
            @Model.Role
        </span>
    </div>
    <div class="card-body p-4">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase fw-semibold">Matric / Staff ID</small>
                    <div class="fs-5 fw-bold text-dark">@Model.MatricNo</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase fw-semibold">Email Address</small>
                    <div class="fs-5 fw-bold text-primary">@Model.Email</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase fw-semibold">Faculty Affiliation</small>
                    <div class="fs-5 fw-bold text-dark">@(Model.Faculty?.FacultyCode ?? "General Official")</div>
                </div>
            </div>
            <div class="col-md-2">
                <div class="p-3 bg-light rounded border">
                    <small class="text-muted text-uppercase fw-semibold">User ID</small>
                    <div class="fs-5 fw-bold text-muted">#@Model.UserId</div>
                </div>
            </div>
        </div>

        @if (Model.Role == "Scorekeeper" || Model.AssignedMatches.Any())
        {
            <h5 class="fw-bold mb-3"><i class="bi bi-stopwatch text-warning me-2"></i>Assigned Match Fixtures</h5>
            <div class="table-responsive mb-4">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Fixture</th>
                            <th>Sport</th>
                            <th>Date</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.AssignedMatches)
                        {
                            <tr>
                                <td class="fw-semibold">@m.HomeFaculty?.FacultyCode vs @m.AwayFaculty?.FacultyCode</td>
                                <td>@m.Sport?.SportName</td>
                                <td>@m.MatchDate.ToString("dd MMM yyyy, h:mm tt")</td>
                                <td>
                                    <span class="badge @(m.Status == "Live" ? "bg-danger" : m.Status == "Completed" ? "bg-success" : "bg-primary")">
                                        @m.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="pt-3 border-top d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Users
            </a>
            <a asp-action="Edit" asp-route-id="@Model.UserId" class="btn btn-warning">
                <i class="bi bi-pencil me-1"></i> Edit Account
            </a>
        </div>
    </div>
</div>

