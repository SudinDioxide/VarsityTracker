@model VarsityTracker.Core.Models.Player
@{
    ViewData["Title"] = "Athlete Details - " + Model.FullName;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Athlete Rosters</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.FullName</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header form-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                    {
                        <img src="@Model.PhotoUrl" alt="@Model.FullName" class="rounded-circle object-fit-cover shadow border border-2 border-white" style="width: 58px; height: 58px;" />
                    }
                    else
                    {
                        <div class="form-card-header-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                    }
                    <div>
                        <h4 class="mb-0 fw-bold text-white">@Model.FullName</h4>
                        <small class="text-white-50">Student Athlete Profile &bull; @Model.PositionRole</small>
                    </div>
                </div>
                <span class="badge bg-warning text-dark fs-6 px-3 py-2 fw-bold">@Model.Faculty?.FacultyCode</span>
            </div>
            <div class="card-body p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Matric Number</small>
                            <div class="fs-5 fw-bold text-dark mt-1 font-monospace">@Model.MatricNo</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Faculty Affiliation</small>
                            <div class="fs-6 fw-bold text-primary mt-1">@Model.Faculty?.FacultyName</div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 bg-light rounded-3 border">
                            <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Playing Position</small>
                            <div class="fs-5 fw-bold text-success mt-1">
                                <i class="bi bi-shield-shaded me-1"></i>@Model.PositionRole
                            </div>
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 border text-center">
                        <small class="text-muted text-uppercase fw-bold d-block mb-2" style="font-size: 11px;">Athlete Official Photo</small>
                        <img src="@Model.PhotoUrl" alt="@Model.FullName" class="img-fluid rounded-3 shadow-sm border" style="max-height: 260px; object-fit: cover;" />
                    </div>
                }

                <div class="mt-4 pt-3 border-top d-flex justify-content-between">
                    <a asp-action="Index" asp-route-facultyId="@Model.FacultyId" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Back to Rosters
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model.PlayerId" class="btn btn-warning fw-bold shadow-sm">
                        <i class="bi bi-pencil me-1"></i> Edit Athlete
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

