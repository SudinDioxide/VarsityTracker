@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger p-4">
            <div class="text-danger mb-3">
                <i class="bi bi-shield-x" style="font-size: 4rem;"></i>
            </div>
            <h2 class="text-danger fw-bold">Access Denied</h2>
            <p class="text-muted mt-2">
                You do not have the required role or authorization to access this varsity administrative module.
            </p>
            <div class="mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary me-2">
                    <i class="bi bi-house me-1"></i> Return Home
                </a>
                <a asp-action="Login" class="btn btn-primary">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>

