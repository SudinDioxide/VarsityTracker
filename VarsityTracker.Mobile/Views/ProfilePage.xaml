<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VarsityTracker.Mobile.Views.ProfilePage"
             Title="Student Profile"
             BackgroundColor="#F8F9FA">

    <ScrollView>
        <VerticalStackLayout Spacing="0">
            <!-- Header Profile Card -->
            <Border BackgroundColor="#0D2B45" Padding="20, 24" StrokeThickness="0">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Border WidthRequest="76" HeightRequest="76" StrokeShape="RoundRectangle 38" BackgroundColor="White" Stroke="#FFC107" StrokeThickness="3" Padding="6" HorizontalOptions="Center">
                        <Image Source="uthm_logo.png" Aspect="AspectFit" WidthRequest="60" HeightRequest="60" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <Label x:Name="FullNameHeaderLabel" Text="Muhammad Farhan" TextColor="White" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Label x:Name="MatricHeaderLabel" Text="Matric No: AI220015" TextColor="#FFC107" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                    <Border BackgroundColor="#1E3A8A" Padding="10, 4" StrokeShape="RoundRectangle 12" StrokeThickness="0" HorizontalOptions="Center">
                        <Label x:Name="FacultyBadgeLabel" Text="FSKTM • Computer Science" TextColor="White" FontSize="11" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- Profile Details Card (READ) -->
            <Border Margin="16, 16" Padding="16" StrokeShape="RoundRectangle 10" BackgroundColor="White" Stroke="#E9ECEF" StrokeThickness="1">
                <VerticalStackLayout Spacing="12">
                    <Label Text="ACCOUNT DETAILS (READ)" FontSize="11" TextColor="#6C757D" FontAttributes="Bold" CharacterSpacing="1" />

                    <!-- Matric No (Read Only) -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Matric Number" FontSize="11" TextColor="#6C757D" />
                        <Label x:Name="MatricValueLabel" Text="AI220015" FontSize="15" FontAttributes="Bold" TextColor="#212529" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#F1F3F5" />

                    <!-- Full Name -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Full Name" FontSize="11" TextColor="#6C757D" />
                        <Entry x:Name="FullNameEntry" FontSize="14" TextColor="#212529" BackgroundColor="#F8F9FA" />
                    </VerticalStackLayout>

                    <!-- Email -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Siswa Email" FontSize="11" TextColor="#6C757D" />
                        <Entry x:Name="EmailEntry" FontSize="14" TextColor="#212529" BackgroundColor="#F8F9FA" Keyboard="Email" />
                    </VerticalStackLayout>

                    <!-- Faculty Affiliation -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Primary Faculty Preference" FontSize="11" TextColor="#6C757D" />
                        <Picker x:Name="FacultyPicker" BackgroundColor="#F8F9FA" Title="Select Faculty" />
                    </VerticalStackLayout>

                    <!-- UPDATE Action Button -->
                    <Button Text="💾 Save Profile Changes (Mobile CRUD #1)" 
                            Clicked="OnSaveProfileClicked"
                            BackgroundColor="#0D6EFD"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="8"
                            HeightRequest="42"
                            Margin="0, 8, 0, 0" />
                </VerticalStackLayout>
            </Border>

            <!-- Student Authentication & Switcher -->
            <Border Margin="16, 0, 16, 16" Padding="16" StrokeShape="RoundRectangle 10" BackgroundColor="White" Stroke="#E9ECEF" StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="STUDENT AUTHENTICATION &amp; LOGIN" FontSize="11" TextColor="#6C757D" FontAttributes="Bold" CharacterSpacing="1" />

                    <Button Text="🔑 Login with Matric / Email &amp; Password" 
                            Clicked="OnLoginClicked"
                            BackgroundColor="#0D2B45"
                            TextColor="#FFC107"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="8"
                            HeightRequest="42" />

                    <Label Text="Quick 1-Tap Demo Switcher:" FontSize="11" TextColor="#6C757D" Margin="0, 4, 0, 0" />
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="👤 Farhan (FSKTM)" 
                                Clicked="OnQuickLoginFarhanClicked"
                                BackgroundColor="#EEF2FF"
                                TextColor="#3730A3"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="38" />

                        <Button Grid.Column="1" Text="👤 Aisyah (FKEE)" 
                                Clicked="OnQuickLoginAisyahClicked"
                                BackgroundColor="#FEF3C7"
                                TextColor="#92400E"
                                FontAttributes="Bold"
                                FontSize="12"
                                CornerRadius="8"
                                HeightRequest="38" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Account Management Actions (CREATE & DELETE) -->
            <Border Margin="16, 0, 16, 24" Padding="16" StrokeShape="RoundRectangle 10" BackgroundColor="White" Stroke="#E9ECEF" StrokeThickness="1">
                <VerticalStackLayout Spacing="10">
                    <Label Text="ACCOUNT ACTIONS (CREATE &amp; DELETE)" FontSize="11" TextColor="#6C757D" FontAttributes="Bold" CharacterSpacing="1" />

                    <Button Text="➕ Register Another Student Profile" 
                            Clicked="OnRegisterNewProfileClicked"
                            BackgroundColor="#10B981"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="8"
                            HeightRequest="40" />

                    <Button Text="🗑️ Deactivate / Delete Student Account" 
                            Clicked="OnDeleteProfileClicked"
                            BackgroundColor="#FEE2E2"
                            TextColor="#DC2626"
                            FontAttributes="Bold"
                            FontSize="13"
                            CornerRadius="8"
                            HeightRequest="40" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
