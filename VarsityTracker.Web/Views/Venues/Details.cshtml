@model VarsityTracker.Core.Models.Venue
@{
    ViewData["Title"] = "Venue Details - " + Model.VenueName;
}

<!-- Breadcrumbs -->
<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Venues &amp; Facilities</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.VenueName</li>
    </ol>
</nav>

<div class="card shadow border-0 mb-4">
    <!-- Modern Header -->
    <div class="form-card-header d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div class="d-flex align-items-center gap-3">
            <div class="form-card-header-icon shadow-sm">
                <i class="bi bi-geo-alt-fill"></i>
            </div>
            <div>
                <h4 class="mb-1 fw-bold text-white">@Model.VenueName</h4>
                <p class="mb-0 text-white-50 small"><i class="bi bi-pin-map-fill text-warning me-1"></i>@Model.Location</p>
            </div>
        </div>
        <div>
            @if (Model.IsAvailable)
            {
                <span class="badge bg-success px-3 py-2 fs-6 shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Operational &amp; Available</span>
            }
            else
            {
                <span class="badge bg-danger px-3 py-2 fs-6 shadow-sm"><i class="bi bi-tools me-1"></i>Closed / Maintenance</span>
            }
        </div>
    </div>

    <div class="card-body p-4 p-md-5">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mb-4 rounded-3 overflow-hidden shadow-sm border" style="max-height: 280px;">
                <img src="@Model.ImageUrl" alt="@Model.VenueName" class="w-100 object-fit-cover" style="max-height: 280px;" onerror="this.parentElement.style.display='none';" />
            </div>
        }
        <!-- Metric Cards -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <span class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-3">
                        <i class="bi bi-calendar-event"></i>
                    </span>
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Matches Scheduled</small>
                        <div class="fs-4 fw-bold text-dark">@Model.Matches.Count Fixtures</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <span class="p-3 bg-danger bg-opacity-10 text-danger rounded-3 fs-3">
                        <i class="bi bi-shield-exclamation"></i>
                    </span>
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Safety Hazard Reports</small>
                        <div class="fs-4 fw-bold text-danger">@Model.VenueFeedbacks.Count Reports</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border d-flex align-items-center gap-3">
                    <span class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-3">
                        <i class="bi bi-check2-circle"></i>
                    </span>
                    <div>
                        <small class="text-muted text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.05em;">Operational Status</small>
                        <div class="fs-5 fw-bold text-success">@(Model.IsAvailable ? "Active Service" : "Offline / Maintenance")</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Section: Safety Tickets -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark mb-0">
                <i class="bi bi-ticket-detailed-fill text-danger me-2"></i>Student Safety &amp; Defect Inspection Reports
            </h5>
            <span class="badge bg-secondary">Total: @Model.VenueFeedbacks.Count</span>
        </div>

        <div class="table-container mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Date Submitted</th>
                            <th>Reported By</th>
                            <th>Issue Subject</th>
                            <th>Description</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.VenueFeedbacks.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-shield-check fs-2 text-success d-block mb-1"></i>
                                    No safety hazards or defect tickets filed for this facility. Everything is in order!
                                </td>
                            </tr>
                        }
                        @foreach (var fb in Model.VenueFeedbacks)
                        {
                            <tr>
                                <td><span class="text-muted small">@fb.SubmittedAt.ToString("dd MMM yyyy, h:mm tt")</span></td>
                                <td>
                                    <div class="fw-semibold text-dark">@fb.User?.FullName</div>
                                    <small class="text-muted"><code>@fb.User?.MatricNo</code></small>
                                </td>
                                <td class="fw-bold text-dark">@fb.Subject</td>
                                <td class="small text-muted" style="max-width: 320px;">@fb.Details</td>
                                <td>
                                    <span class="badge @(fb.Status == "Resolved" ? "bg-success" : fb.Status == "In Review" ? "bg-warning text-dark" : "bg-secondary")">
                                        @fb.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Action Footer -->
        <div class="pt-3 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary px-4">
                <i class="bi bi-arrow-left me-1"></i> Back to Venues
            </a>
            @if (User.IsInRole("Admin"))
            {
                <div class="d-flex gap-2">
                    <form asp-action="ToggleAvailability" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.VenueId" />
                        <button type="submit" class="btn @(Model.IsAvailable ? "btn-warning" : "btn-success") px-4">
                            <i class="bi bi-arrow-repeat me-1"></i> Toggle Status to @(Model.IsAvailable ? "Maintenance" : "Available")
                        </button>
                    </form>
                    <a asp-action="Edit" asp-route-id="@Model.VenueId" class="btn btn-primary px-4">
                        <i class="bi bi-pencil-square me-1"></i> Edit Facility
                    </a>
                </div>
            }
        </div>
    </div>
</div>

