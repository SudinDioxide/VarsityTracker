@model IEnumerable<VarsityTracker.Core.Models.Match>
@{
    ViewData["Title"] = "Match Fixtures & Schedule";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Match Fixtures</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">Match Fixtures & Scheduling</h2>
            <span class="badge bg-primary rounded-pill">@Model.Count() Matches</span>
        </div>
        <p class="text-muted mb-0 small mt-1">Varsity tournament calendar, referee assignments, court locations, and live results</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportCsv" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export CSV
        </a>
        <a asp-controller="LiveScore" asp-action="Index" class="btn btn-danger shadow-sm">
            <i class="bi bi-broadcast me-1"></i> Live Center
        </a>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Schedule Fixture
            </a>
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-funnel"></i></span>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        <option value="Live" selected="@(ViewData["CurrentStatus"] as string == "Live")">🔴 Live Now</option>
                        <option value="Scheduled" selected="@(ViewData["CurrentStatus"] as string == "Scheduled")">Scheduled</option>
                        <option value="Completed" selected="@(ViewData["CurrentStatus"] as string == "Completed")">Completed (FT)</option>
                        <option value="Cancelled" selected="@(ViewData["CurrentStatus"] as string == "Cancelled")">Cancelled</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-trophy"></i></span>
                    <select name="sportId" class="form-select" asp-items="ViewBag.Sports">
                        <option value="">All Sports</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control" placeholder="Search by faculty, venue..." />
                </div>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-check-lg me-1"></i>Filter</button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Reset Filters"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="table-container">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 110px;">Status</th>
                    <th>Sport</th>
                    <th>Fixture Matchup</th>
                    <th class="text-center" style="width: 120px;">Score</th>
                    <th>Venue & Time</th>
                    <th>Official</th>
                    <th class="text-end" style="width: 170px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-calendar-x fs-1 d-block mb-2 text-secondary opacity-50"></i>
                            <div class="fw-semibold">No match fixtures found matching your criteria.</div>
                            <small>Try selecting a different filter or schedule a new match.</small>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr class="@(item.Status == "Live" ? "table-danger bg-opacity-25" : "")">
                        <td>
                            @if (item.Status == "Live")
                            {
                                <span class="badge badge-subtle-danger d-inline-flex align-items-center gap-1">
                                    <span class="spinner-grow spinner-grow-sm text-danger" style="width: 8px; height: 8px;" role="status"></span>
                                    LIVE NOW
                                </span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="badge badge-subtle-success d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-check2-circle"></i> FT
                                </span>
                            }
                            else if (item.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge badge-subtle-primary d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-clock"></i> Scheduled
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border px-2 py-1 fw-semibold">
                                @(item.Sport?.SportName switch {
                                    "Futsal" => "⚽ ",
                                    "Badminton" => "🏸 ",
                                    "Basketball" => "🏀 ",
                                    "Volleyball" => "🏐 ",
                                    _ => "🏆 "
                                })@item.Sport?.SportName
                            </span>
                        </td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-primary px-2 py-1 fs-6">@item.HomeFaculty?.FacultyCode</span>
                                <span class="text-muted fw-bold small">VS</span>
                                <span class="badge bg-danger px-2 py-1 fs-6">@item.AwayFaculty?.FacultyCode</span>
                            </div>
                        </td>
                        <td class="text-center">
                            @if (item.Status == "Scheduled")
                            {
                                <span class="badge bg-light text-muted border px-2 py-1 font-monospace">-- : --</span>
                            }
                            else
                            {
                                <span class="badge bg-dark fs-6 px-3 py-1 font-monospace shadow-sm" style="letter-spacing: 1px;">
                                    @item.HomeTotalScore - @item.AwayTotalScore
                                </span>
                            }
                        </td>
                        <td>
                            <div class="fw-semibold small"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.Venue?.VenueName</div>
                            <div class="text-muted small"><i class="bi bi-calendar3 me-1"></i>@item.MatchDate.ToString("dd MMM yyyy, h:mm tt")</div>
                        </td>
                        <td class="small">
                            @if (item.Scorekeeper != null)
                            {
                                <span class="badge bg-light text-dark border"><i class="bi bi-person-badge me-1"></i>@item.Scorekeeper.FullName</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">Unassigned</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@item.MatchId" class="btn btn-outline-secondary" title="View Details">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (User.IsInRole("Admin") || User.IsInRole("Scorekeeper"))
                                {
                                    <a asp-controller="LiveScore" asp-action="Console" asp-route-id="@item.MatchId" class="btn btn-outline-danger" title="Scorekeeper Console">
                                        <i class="bi bi-stopwatch"></i>
                                    </a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.MatchId" class="btn btn-outline-primary" title="Edit Fixture">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.MatchId" class="btn btn-outline-danger" title="Cancel/Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

