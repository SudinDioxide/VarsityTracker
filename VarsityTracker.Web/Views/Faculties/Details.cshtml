@model VarsityTracker.Core.Models.Faculty
@{
    ViewData["Title"] = "Faculty Details - " + Model.FacultyCode;
    var homeMatches = ViewBag.HomeMatches as List<VarsityTracker.Core.Models.Match> ?? new List<VarsityTracker.Core.Models.Match>();
    var awayMatches = ViewBag.AwayMatches as List<VarsityTracker.Core.Models.Match> ?? new List<VarsityTracker.Core.Models.Match>();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Faculties</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.FacultyCode</li>
    </ol>
</nav>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header form-card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div class="d-flex align-items-center gap-3">
            <div class="form-card-header-icon">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark fw-bold">@Model.FacultyCode</span>
                    <h4 class="mb-0 fw-bold text-white">@Model.FacultyName</h4>
                </div>
                <small class="text-white-50">Faculty Sports Delegation &bull; Official Varsity Contingent</small>
            </div>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model.FacultyId" class="btn btn-sm btn-warning fw-bold shadow-sm">
                <i class="bi bi-pencil me-1"></i> Edit Faculty
            </a>
        }
    </div>
    <div class="card-body p-4">
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Sports Coordinator</small>
                    <div class="fs-5 fw-bold text-dark mt-1">
                        <i class="bi bi-person-badge text-primary me-1"></i>@(string.IsNullOrEmpty(Model.ManagerName) ? "Unassigned" : Model.ManagerName)
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Registered Athletes</small>
                    <div class="fs-5 fw-bold text-primary mt-1 font-monospace">@Model.Players.Count Athletes</div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="p-3 bg-light rounded-3 border">
                    <small class="text-muted text-uppercase fw-bold" style="font-size: 11px;">Total Fixtures</small>
                    <div class="fs-5 fw-bold text-success mt-1 font-monospace">@(homeMatches.Count + awayMatches.Count) Matches</div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-people me-2 text-primary"></i>Official Team Roster</h5>
            <a asp-controller="Players" asp-action="Create" asp-route-facultyId="@Model.FacultyId" class="btn btn-sm btn-primary shadow-sm">
                <i class="bi bi-person-plus me-1"></i> Add Athlete
            </a>
        </div>

        <div class="table-container mb-4">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Athlete</th>
                            <th>Matric Number</th>
                            <th>Position / Role</th>
                            <th class="text-end" style="width: 140px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Players.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4 text-muted">
                                    <i class="bi bi-person-x fs-1 d-block mb-1 text-secondary opacity-50"></i>
                                    No student athletes enrolled for @Model.FacultyCode yet.
                                </td>
                            </tr>
                        }
                        @foreach (var player in Model.Players)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(player.PhotoUrl))
                                        {
                                            <img src="@player.PhotoUrl" alt="@player.FullName" class="rounded-circle object-fit-cover shadow-sm border" style="width: 36px; height: 36px;" />
                                        }
                                        else
                                        {
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 36px; height: 36px; font-size: 13px;">
                                                @(string.IsNullOrWhiteSpace(player.FullName) ? "A" : player.FullName.Substring(0, 1).ToUpper())
                                            </div>
                                        }
                                        <span class="fw-bold text-dark">@player.FullName</span>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border font-monospace">@player.MatricNo</span></td>
                                <td><span class="badge badge-subtle-primary"><i class="bi bi-shield me-1"></i>@player.PositionRole</span></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="Players" asp-action="Details" asp-route-id="@player.PlayerId" class="btn btn-outline-secondary" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-controller="Players" asp-action="Edit" asp-route-id="@player.PlayerId" class="btn btn-outline-primary" title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-controller="Players" asp-action="Delete" asp-route-id="@player.PlayerId" class="btn btn-outline-danger" title="Remove">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="pt-3 border-top d-flex justify-content-between">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back to Faculties
            </a>
        </div>
    </div>
</div>

