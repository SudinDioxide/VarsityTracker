@model IEnumerable<VarsityTracker.Core.Models.VenueFeedback>
@{
    ViewData["Title"] = "Facility Safety & Hazard Feedback";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item active" aria-current="page">Facility Safety Tickets</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <div class="d-flex align-items-center gap-2">
            <h2 class="fw-bold mb-0 text-dark">Facility Safety & Hazard Reports</h2>
            <span class="badge bg-danger rounded-pill">@Model.Count() Reports</span>
        </div>
        <p class="text-muted mb-0 small mt-1">Student safety feedback, lighting defects, surface hazards, and campus facility tickets</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="ExportCsv" class="btn btn-outline-success">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Export Safety Log (CSV)
            </a>
        }
        <a asp-action="Create" class="btn btn-danger shadow-sm">
            <i class="bi bi-plus-circle me-1"></i> Submit Safety Report
        </a>
    </div>
</div>

<div class="table-container">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 140px;">Report Date</th>
                    <th>Facility</th>
                    <th>Reported By</th>
                    <th>Issue Subject & Description</th>
                    <th style="width: 130px;">Status</th>
                    <th class="text-end" style="width: 160px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-shield-check fs-1 d-block mb-2 text-success opacity-50"></i>
                            <div class="fw-semibold">No safety hazards or maintenance reports filed.</div>
                            <small>All sports venues and facilities are currently operating normally.</small>
                        </td>
                    </tr>
                }
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="small text-muted">
                            <i class="bi bi-calendar3 me-1"></i>@item.SubmittedAt.ToString("dd MMM yyyy")
                            <div class="text-muted" style="font-size: 11px;">@item.SubmittedAt.ToString("h:mm tt")</div>
                        </td>
                        <td>
                            <div class="fw-bold text-dark"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@item.Venue?.VenueName</div>
                            <small class="text-muted">@item.Venue?.Location</small>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@item.User?.FullName</div>
                            <span class="badge bg-light text-muted border font-monospace" style="font-size: 11px;">@item.User?.MatricNo</span>
                        </td>
                        <td>
                            <div class="fw-bold text-dark">@item.Subject</div>
                            <small class="text-muted text-break">@item.Details</small>
                        </td>
                        <td>
                            @if (item.Status == "Resolved")
                            {
                                <span class="badge badge-subtle-success d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-check2-circle"></i> Resolved
                                </span>
                            }
                            else if (item.Status == "In Review")
                            {
                                <span class="badge badge-subtle-warning d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-search"></i> In Review
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary d-inline-flex align-items-center gap-1">
                                    <i class="bi bi-hourglass-split"></i> Pending
                                </span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex align-items-center gap-1">
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Status
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow">
                                            <li>
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="feedbackId" value="@item.FeedbackId" />
                                                    <input type="hidden" name="newStatus" value="In Review" />
                                                    <button type="submit" class="dropdown-item"><i class="bi bi-search me-2 text-warning"></i>Mark In Review</button>
                                                </form>
                                            </li>
                                            <li>
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="feedbackId" value="@item.FeedbackId" />
                                                    <input type="hidden" name="newStatus" value="Resolved" />
                                                    <button type="submit" class="dropdown-item text-success"><i class="bi bi-check2-circle me-2 text-success"></i>Mark Resolved</button>
                                                </form>
                                            </li>
                                            <li><hr class="dropdown-divider"></li>
                                            <li>
                                                <form asp-action="UpdateStatus" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="feedbackId" value="@item.FeedbackId" />
                                                    <input type="hidden" name="newStatus" value="In Review" />
                                                    <input type="hidden" name="closeVenue" value="true" />
                                                    <button type="submit" class="dropdown-item text-danger">
                                                        <i class="bi bi-tools me-2 text-danger"></i>Close Venue for Repairs
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                }
                                <form asp-action="Delete" asp-route-id="@item.FeedbackId" method="post" class="d-inline" onsubmit="return confirm('Withdraw this feedback ticket?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Withdraw Ticket">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

