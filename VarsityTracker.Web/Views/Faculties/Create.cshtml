@model VarsityTracker.Core.Models.Faculty
@{
    ViewData["Title"] = "Register Faculty";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Dashboard</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Faculties</a></li>
        <li class="breadcrumb-item active" aria-current="page">Register Faculty</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-header form-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="form-card-header-icon">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <div>
                        <h4 class="mb-0 fw-bold">Register University Faculty</h4>
                        <p class="mb-0 small text-white-50">Create faculty sports delegation, acronym code, and assign team coordinator</p>
                    </div>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert badge-subtle-danger py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="FacultyCode" class="form-label">Faculty Code / Acronym</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-tag-fill text-primary"></i></span>
                            <input asp-for="FacultyCode" class="form-control text-uppercase font-monospace" placeholder="e.g. FSKTM, FKEE, FAST" required />
                        </div>
                        <span asp-validation-for="FacultyCode" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FacultyName" class="form-label">Full Faculty Name</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-building text-secondary"></i></span>
                            <input asp-for="FacultyName" class="form-control" placeholder="e.g. Fakulti Sains Komputer dan Teknologi Maklumat" required />
                        </div>
                        <span asp-validation-for="FacultyName" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ManagerName" class="form-label">Faculty Sports Coordinator / Manager</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-fill text-success"></i></span>
                            <input asp-for="ManagerName" class="form-control" placeholder="e.g. Dr. Radzi Bin Ahmad" />
                        </div>
                        <span asp-validation-for="ManagerName" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between pt-3 border-top">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Faculties
                        </a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-save me-1"></i> Save Faculty
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

